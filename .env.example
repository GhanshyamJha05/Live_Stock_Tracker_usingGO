# Stock Tracker Environment Variables

# Server
PORT=8080
ENV=development

# API Configuration
API_PROVIDER=mock
STOCK_API_KEY=

# Update Settings
UPDATE_INTERVAL=5
MAX_CONNECTIONS=1000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Default Stocks (comma-separated)
DEFAULT_STOCKS=AAPL,GOOGL,MSFT,AMZN,TSLA,META,NVDA
